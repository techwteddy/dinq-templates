# .env.local — NutriApp
# Copia este archivo como .env.local y rellena los valores.
# NUNCA subas .env.local al repositorio.

# ── Supabase ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Service role — SOLO en servidor, nunca en cliente
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── FoodData Central (USDA) ────────────────────────────────
# Obtén tu API key en: https://fdc.nal.usda.gov/api-guide.html
FDC_API_KEY=DEMO_KEY

# ── Web Push / VAPID ──────────────────────────────────────
# Genera con: node scripts/generate-vapid-keys.mjs
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BL...
VAPID_PRIVATE_KEY=...
VAPID_SUBJECT=mailto:tu@email.com

# ── Cron Secret ───────────────────────────────────────────
# Secret aleatorio para autenticar los Vercel Cron Jobs
# Genera con: openssl rand -hex 32
CRON_SECRET=...

# ── Entorno ───────────────────────────────────────────────
NODE_ENV=development
