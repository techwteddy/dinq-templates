# --- Supabase ---------------------------------------------------------------
# Obtén estos valores en Supabase > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor. Nunca exponer en cliente.
SUPABASE_SERVICE_ROLE_KEY=

# --- APIs nutricionales -----------------------------------------------------
# USDA FoodData Central.
FDC_API_KEY=DEMO_KEY

# Open Food Facts no requiere key.
OPEN_FOOD_FACTS_BASE_URL=https://world.openfoodfacts.org/api/v2

# --- Web Push / PWA ---------------------------------------------------------
# Requerida para que el navegador pueda crear suscripciones push.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Requerida solo en servidor para enviar notificaciones.
VAPID_PRIVATE_KEY=
# Requerida por Web Push; usa mailto:tu-correo o una URL válida.
VAPID_SUBJECT=mailto:tu@email.com
# Requerida en servidor/Vercel para autenticar /api/push/send y /api/push/cron.
CRON_SECRET=
