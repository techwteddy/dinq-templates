# Supabase Configuration
# Copy this file to .env.local and fill in your actual values
# 
# To get these values:
# 1. Go to your Supabase project dashboard
# 2. Navigate to Settings > API
# 3. Copy the Project URL (for NEXT_PUBLIC_SUPABASE_URL)
# 4. Copy the anon/public key (for NEXT_PUBLIC_SUPABASE_ANON_KEY)
# 5. Copy the service_role key (for SUPABASE_SERVICE_ROLE_KEY) - Keep this secret!

NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional: Seed Script Configuration
# Only needed if running scripts/seed-users.js
# SECURITY: Never commit actual passwords to version control!
# SEED_SUPERVISOR_EMAIL=supervisor@example.com
# SEED_SUPERVISOR_PASSWORD=your_secure_password_here
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=your_secure_password_here





