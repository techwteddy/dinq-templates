# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Festival (optional — if set, uses this slug; otherwise uses the first is_active=true festival)
FESTIVAL_SLUG=

# Email / SMTP (optional — rides work without it, management links are logged to console)
# Gmail:  SMTP_HOST=smtp.gmail.com  (use a Google App Password as BREVO_SMTP_KEY)
# Brevo:  SMTP_HOST=smtp-relay.brevo.com
SMTP_HOST=
SMTP_PORT=587
BREVO_SMTP_USER=your-email@example.com
BREVO_SMTP_KEY=your-smtp-password-or-app-password
BREVO_SENDER_EMAIL=your-sender@example.com
