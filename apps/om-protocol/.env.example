# =============================================================================
# The OM Protocol — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values.
# Never commit .env.local to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# Public-facing URL of the deployed app (used for OG meta, canonical URLs)
NEXT_PUBLIC_APP_URL=https://theomprotocol.com

# -----------------------------------------------------------------------------
# Supabase — https://supabase.com/dashboard/project/_/settings/api
# -----------------------------------------------------------------------------
# Project URL: found in Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon (public) key: Settings > API > Project API keys > anon/public
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key

# Service role key (server-side only, never expose to client):
# Settings > API > Project API keys > service_role
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your-service-role-key

# -----------------------------------------------------------------------------
# Stripe — https://dashboard.stripe.com/apikeys
# -----------------------------------------------------------------------------
# Publishable key (safe for client): Developers > API keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Secret key (server-side only): Developers > API keys
STRIPE_SECRET_KEY=sk_test_...

# Webhook signing secret: Developers > Webhooks > select endpoint > Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# -----------------------------------------------------------------------------
# Sanity CMS — https://www.sanity.io/manage
# -----------------------------------------------------------------------------
# Project ID: found in sanity.io/manage > your project
SANITY_PROJECT_ID=your-project-id

# Dataset name: typically "production"
SANITY_DATASET=production

# -----------------------------------------------------------------------------
# Anthropic (Claude API) — https://console.anthropic.com/settings/keys
# -----------------------------------------------------------------------------
# API key for AI-powered journal analysis (server-side only)
ANTHROPIC_API_KEY=sk-ant-...
