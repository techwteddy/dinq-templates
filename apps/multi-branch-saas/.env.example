# ============================================
# BRANCH MANAGEMENT BOILERPLATE - ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and fill in your actual values
# Never commit .env to version control!
# ============================================

# ============================================
# DATABASE (REQUIRED)
# ============================================
# PostgreSQL connection string for Prisma ORM
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
#
# Local Development (Supabase local):
#   DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
#
# Production (Supabase hosted):
#   DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# ============================================
# SUPABASE (REQUIRED)
# ============================================
# Supabase project URL and keys for authentication & database access
# Get these from: Supabase Dashboard > Project Settings > API
#
# Local Development (Supabase local):
#   - URL: http://127.0.0.1:54321
#   - Anon Key: Your local anon key from supabase start output
#   - Service Role Key: Your local service role key
#
# Production (Supabase hosted):
#   - URL: https://[project-ref].supabase.co
#   - Anon Key: Your project's anon/public key
#   - Service Role Key: Your project's service_role key (KEEP SECRET!)

# Public Supabase URL (exposed to client)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Anonymous/Public key (safe to expose to client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Service Role key (server-side only, NEVER expose to client!)
# Used for admin operations that bypass Row Level Security
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ============================================
# APPLICATION (OPTIONAL)
# ============================================

# Public URL of your application
# Used for: email links, OAuth redirects, absolute URLs
# Development: http://localhost:3000
# Production: https://yourdomain.com
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Maximum depth for branch hierarchy (default: 5)
# Controls how many levels deep the branch tree can go
# Example: HQ > Branch > Sub-Branch > Sub-Sub-Branch > ...
# MAX_BRANCH_DEPTH=5

# ============================================
# DEVELOPMENT (OPTIONAL)
# ============================================

# Node environment (automatically set by Next.js)
# NODE_ENV=development

# ============================================
# EMAIL SERVICE (OPTIONAL BUT RECOMMENDED)
# ============================================
# Email service for transactional emails (welcome, password reset, etc.)
# Using Resend (https://resend.com) - get API key from dashboard

# Resend API Key (get from https://resend.com/api-keys)
RESEND_API_KEY=your_resend_api_key_here

# Email sender address (must be verified domain in Resend)
# For development/testing: Use resend's test domain onboarding@resend.dev
# For production: Use your own verified domain
EMAIL_FROM=RepairShop <onboarding@resend.dev>

# Optional: Reply-to email address
# EMAIL_REPLY_TO=support@yourdomain.com

# ============================================
# FUTURE INTEGRATIONS (OPTIONAL)
# ============================================
# Uncomment and configure as needed when implementing:

# Error Tracking (Sentry)
# NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn_here
# SENTRY_AUTH_TOKEN=your_sentry_auth_token_here

# Analytics (Google Analytics, Plausible, etc.)
# NEXT_PUBLIC_GA_ID=your_google_analytics_id_here

# ============================================
# NOTES
# ============================================
# 1. Copy this file: cp .env.example .env
# 2. Fill in your actual values in .env
# 3. Never commit .env to git (already in .gitignore)
# 4. For production, use environment variables in your hosting platform
# 5. Restart dev server after changing environment variables
