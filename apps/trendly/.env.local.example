NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Server-only. Used by src/lib/ai.ts to read/write the ai_cache table
# (RLS blocks anon + authenticated, so we must bypass with the service role).
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Anthropic API key (server-only). Needed for natural-language match
# reasons and AI-drafted intro messages on the Smart Matching screens.
ANTHROPIC_API_KEY=sk-ant-...
