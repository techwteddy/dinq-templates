# ==========================================
# Server Environment Health Dashboard Config
# ==========================================

# Supabase Configuration (Wajib)
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_ID].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJh..."
SUPABASE_SERVICE_ROLE_KEY="eyJh..." # Untuk API Route (Backend)

# App Configuration
# Format: ENV_NAME|URL, ENV_NAME|URL
# Contoh: DEV|https://dev-api.example.com/health,SIT|https://sit-api.example.com/health,PROD|https://api.example.com/health
TARGET_ENVIRONMENTS="DEV|https://dev-api.example.com/health,SIT|https://sit-api.example.com/health,PROD|https://api.example.com/health"

# Polling Interval in milliseconds (e.g., 60000 for 1 minute)
NEXT_PUBLIC_POLLING_INTERVAL=60000