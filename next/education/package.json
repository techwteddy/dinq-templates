{
  "name": "education-website-template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"velite dev\" \"next dev\"",
    "build": "velite build && next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:e2e": "playwright test --config=infra/config/playwright.config.ts",
    "docker:build": "docker build -f infra/docker/Dockerfile -t education-website-template .",
    "docker:up": "docker-compose -f infra/docker/docker-compose.yml up",
    "analyze": "cross-env ANALYZE=true bun run build",
    "check-secrets": "secretlint --secretlintrc infra/config/.secretlintrc.json \"**/*\"",
    "lhci": "lhci autorun --config=infra/config/.lighthouserc.js",
    "prepare": "husky"
  },
  "lint-staged": {
    "**/*": [
      "secretlint --secretlintrc infra/config/.secretlintrc.json"
    ],
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-toast": "^1.2.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^0.563.0",
    "next": "14.2.35",
    "next-themes": "^0.4.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.71.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^20.3.1",
    "@lhci/cli": "^0.15.1",
    "@next/bundle-analyzer": "^16.1.4",
    "@playwright/test": "^1.58.0",
    "@secretlint/secretlint-rule-preset-recommend": "^11.3.0",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.6",
    "@types/jest-axe": "^3.5.9",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^20.19.30",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.35",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-security": "1.7.1",
    "eslint-plugin-sonarjs": "0.25.1",
    "happy-dom": "^20.3.7",
    "husky": "^9.1.7",
    "jest-axe": "^10.0.0",
    "jsdom": "^27.4.0",
    "lint-staged": "^16.2.7",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "secretlint": "^11.3.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "velite": "^0.3.1",
    "zod": "^4.3.6"
  },
  "resolutions": {
    "glob": "^10.5.0"
  }
}
